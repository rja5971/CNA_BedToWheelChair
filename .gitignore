# Visual Studio / IDE user specific files
.vs/
.idea/
.vscode/
.claude/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables and Packages
*.exe
*.out
*.app
*.ipa
*.apk
*.aab
*.obb

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds and Packaged Outputs
Build/
Builds/

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Temporary files and logs
temp.*
*.tmp
*.bak
*.orig
*.log

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Developer Logs
devlog.md
